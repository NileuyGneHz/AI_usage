{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "review-cards",
  "description": "W2 唯一的输出契约：抽 3 张复习卡，或者明确拒答。三条 prompt 版本都用它当同一把尺子。",
  "oneOf": [
    { "$ref": "#/$defs/cards" },
    { "$ref": "#/$defs/insufficient" }
  ],
  "$defs": {
    "cards": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cards"],
      "properties": {
        "cards": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["q", "a", "point", "difficulty"],
            "properties": {
              "q": { "type": "string", "minLength": 6, "maxLength": 120 },
              "a": { "type": "string", "minLength": 4, "maxLength": 200 },
              "point": { "type": "string", "minLength": 2, "maxLength": 60 },
              "difficulty": { "type": "string", "enum": ["easy", "medium", "hard"] }
            }
          }
        }
      }
    },
    "insufficient": {
      "type": "object",
      "additionalProperties": false,
      "required": ["error"],
      "properties": {
        "error": { "type": "string", "const": "insufficient" }
      }
    }
  }
}
